# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .<env>.env (e.g. .dev.env, .qa.env, .prod.env) and fill in the
# blank secret values. Real env files are gitignored — only this template is committed.

# ============================================
# CI/CD Configuration (GitlLab)
# ============================================
CI=false

# --- General Settings ---
ENV=dev
PLAYWRIGHT_HEADLESS=false
# Delay (ms) between browser actions; default 500. The MCP configs set 0 for the test agents.
# PLAYWRIGHT_SLOWMO=500
PLAYWRIGHT_TIMEOUT=30000
APP_NAME="Playwright E2E Framework"

# ============================================
# MULTI-APP CONFIGURATION
# ============================================
# Define URLs for all applications in apps.config.json

# --- Application URLs ---
LOAN_APP_URL=https://localhost:3000  # Cloud: https://129.213.90.227/loan
LENDING_APP_URL=https://localhost:3001  # Cloud: https://129.213.90.227:8443/index

# --- Certificate Passwords (base64 encoded) ---
# To encode: echo -n "your_password" | base64
LOAN_CERT_P12_BASE64=
LENDING_CERT_P12_BASE64=

# --- Custom PEM Certificates (if using custom-pem type) ---
# ANOTHERAPP_CERT_PATH=certs/anotherapp_cert.pem
# ANOTHERAPP_KEY_PATH=certs/anotherapp_key.pem
# ANOTHERAPP_CERT_PASSWORD=Y2hhbmdlbWUK #echo "changeme" | base64

# ============================================
# LEGACY SINGLE-APP CONFIGURATION
# ============================================
# For backward compatibility with old tests

APP_URL=https://localhost:3000/index
# .P12/PFX Cert Password for mutual TLS authentication
CERT_P12_BASE64=

# Uncomment if running tests locally using npx command instead of run_test.sh
# P12_FILE=certs/cn=rohan_bhattarai_proj_admin.p12
# CERT_PATH=certs/admin_cert.pem
# KEY_PATH=certs/admin_key.pem
# P12_CERT_PASSWORD=changeme

# ============================================
# SMTP CONFIGURATION (Email Reports)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rohan.bhattarai.dev@gmail.com
SMTP_PASS=
REPORT_TO=rohan.bhattarai.dev@gmail.com
REPORT_FROM=noreply@gmail.com

# Report paths
REPORT_JSON_PATH=reports/results.json

# ============================================
# JIRA / XRAY INTEGRATION
# ============================================
JIRA_BASE_URL=https://aosqa.atlassian.net
JIRA_USER_EMAIL=rohan.bhattarai.dev@gmail.com
JIRA_XRAY_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
XRAY_CA_PEM_BASE64=

# Xray Test Execution details
TEST_EXECUTION_SUMMARY="Automated Test Execution"
TEST_EXECUTION_DESCRIPTION="This is an automated test execution triggered by the Playwright E2E Framework GitLab CI/CD Pipeline."

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=dev-db.aws.global.com
DB_PORT=5432
DB_USER=rohan.bhattarai
DB_PASSWORD=
DB_NAME=postgres

# ============================================
# GITHUB API TOKEN (for GitHub integration)
# ============================================ 
GITHUB_PERSONAL_ACCESS_TOKEN=

# ============================================
# USAGE EXAMPLES
# ============================================
# 
# Multi-App Mode (v2.1 - All apps):
#   ./run_test.sh -env=dev -tags=@MultiApp
#
# Multi-App Mode (v2.1 - Specific apps):
#   ./run_test.sh -apps=loan-app,cms-app -env=dev -tags=@Test
#
# Legacy Single-App Mode:
#   ./run_test.sh -env=dev -tags=@SmokeTest
#
